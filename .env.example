# Optional: only needed for Supabase cloud WAV uploads at /upload.
# Local USB playback and Rekordbox/FLX10 timing work without this file.
# Copy to .env.local and add values from your OWN development project.
# Never commit .env.local or real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key: never prefix with NEXT_PUBLIC_ or expose in client code.
SUPABASE_SERVICE_ROLE_KEY=
